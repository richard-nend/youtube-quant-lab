{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["team", "decided_utc", "status", "items"],
  "properties": {
    "team": {"type": "string"}, "decided_utc": {"type": "string"},
    "model": {"type": "string"}, "model_version": {"type": "string"},
    "tokens_in": {"type": "integer"}, "tokens_out": {"type": "integer"},
    "status": {"enum": ["ok", "hold_fallback"]}, "error": {"type": "string"},
    "items": {"type": "array", "items": {
      "type": "object", "required": ["symbol", "action", "notional_pct", "order", "reason"],
      "properties": {
        "symbol": {"enum": ["BTC", "ETH"]}, "action": {"enum": ["long", "short", "close", "hold"]},
        "notional_pct": {"type": "number", "minimum": 0, "maximum": 300},
        "order": {"enum": ["market", "limit"]}, "limit_price": {"type": "number", "exclusiveMinimum": 0},
        "stop": {"type": "number", "exclusiveMinimum": 0}, "take_profit": {"type": "number", "exclusiveMinimum": 0},
        "reason": {"type": "string"}}}}
  }
}
